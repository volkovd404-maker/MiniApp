<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Кинотека</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            margin: 0;
            padding: 16px;
            background: var(--tg-theme-bg-color, #ffffff);
            color: var(--tg-theme-text-color, #000000);
            transition: background 0.3s, color 0.3s;
        }
        h1 {
            text-align: center;
            margin-bottom: 20px;
            font-size: 24px;
            color: var(--tg-theme-hint-color, #888);
        }
        .movie-grid {
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-width: 400px;
            margin: 0 auto;
        }
        .movie-card {
            background: var(--tg-theme-secondary-bg-color, #f0f0f0);
            border-radius: 16px;
            padding: 16px;
            display: flex;
            align-items: center;
            gap: 16px;
            cursor: pointer;
            border: 2px solid transparent;
            transition: border-color 0.2s, background 0.2s;
            position: relative;
        }
        .movie-card.selected {
            border-color: var(--tg-theme-button-color, #2481cc);
            background: var(--tg-theme-secondary-bg-color, #e0f0ff);
        }
        .movie-poster {
            width: 70px;
            height: 100px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            color: white;
            flex-shrink: 0;
        }
        .movie-info {
            flex-grow: 1;
        }
        .movie-title {
            font-weight: bold;
            font-size: 18px;
            margin-bottom: 4px;
        }
        .movie-genre {
            font-size: 13px;
            color: var(--tg-theme-hint-color, #999);
            margin-bottom: 4px;
        }
        .movie-desc {
            font-size: 13px;
            opacity: 0.8;
        }
        .select-btn {
            background: var(--tg-theme-button-color, #2481cc);
            color: var(--tg-theme-button-text-color, #ffffff);
            border: none;
            border-radius: 10px;
            padding: 8px 14px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            transition: opacity 0.2s;
            flex-shrink: 0;
        }
        .select-btn:active {
            opacity: 0.8;
        }
        .check-icon {
            display: none;
            position: absolute;
            top: 8px;
            right: 8px;
            background: var(--tg-theme-button-color, #2481cc);
            color: white;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }
        .movie-card.selected .check-icon {
            display: flex;
        }
    </style>
</head>
<body>
    <h1>🎬 Выбери фильм</h1>
    <div class="movie-grid" id="movieGrid">
        <!-- Карточки вставятся через JS -->
    </div>

    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <script>
        (function() {
            const tg = window.Telegram.WebApp;
            tg.ready();
            tg.expand();

            // Применяем цвета из темы Telegram
            function applyTheme() {
                document.documentElement.style.setProperty('--tg-theme-bg-color', tg.backgroundColor);
                document.documentElement.style.setProperty('--tg-theme-text-color', tg.textColor);
                document.documentElement.style.setProperty('--tg-theme-button-color', tg.buttonColor);
                document.documentElement.style.setProperty('--tg-theme-button-text-color', tg.buttonTextColor);
                document.documentElement.style.setProperty('--tg-theme-secondary-bg-color', tg.secondaryBackgroundColor);
                document.documentElement.style.setProperty('--tg-theme-hint-color', tg.hintColor);
            }
            applyTheme();
            tg.onEvent('themeChanged', applyTheme);

            // Список фильмов — легко заменить на свои
            const movies = [
                {
                    id: 1,
                    title: 'Интерстеллар',
                    genre: 'Фантастика, драма',
                    desc: 'Путешествие сквозь червоточину ради спасения человечества.',
                    emoji: '🚀'
                },
                {
                    id: 2,
                    title: 'Начало',
                    genre: 'Фантастика, триллер',
                    desc: 'Кобб — лучший вор в мире снов. Ему предстоит невозможное.',
                    emoji: '🌀'
                },
                {
                    id: 3,
                    title: 'Криминальное чтиво',
                    genre: 'Криминал, комедия',
                    desc: 'Несколько переплетающихся историй из жизни бандитов.',
                    emoji: '🔫'
                },
                {
                    id: 4,
                    title: 'Зелёная миля',
                    genre: 'Драма, фэнтези',
                    desc: 'История огромного смертника с удивительным даром.',
                    emoji: '🐭'
                },
                {
                    id: 5,
                    title: 'Бойцовский клуб',
                    genre: 'Триллер, драма',
                    desc: 'Офисный работник создаёт подпольный бойцовский клуб.',
                    emoji: '🥊'
                },
                {
                    id: 6,
                    title: 'Форрест Гамп',
                    genre: 'Драма, комедия',
                    desc: 'Жизнь простого человека на фоне исторических событий США.',
                    emoji: '🏃'
                }
            ];

            let selectedMovieId = null;

            const movieGrid = document.getElementById('movieGrid');
            const mainButton = tg.MainButton;
            mainButton.setText('Подтвердить выбор');
            mainButton.hide();

            mainButton.onClick(() => {
                if (selectedMovieId) {
                    const movie = movies.find(m => m.id === selectedMovieId);
                    const data = JSON.stringify({
                        action: 'movie_selected',
                        movie_id: movie.id,
                        title: movie.title,
                        timestamp: Date.now()
                    });
                    tg.sendData(data);
                    tg.showPopup({
                        title: 'Отлично!',
                        message: `Вы выбрали: ${movie.title}`,
                        buttons: [{ type: 'ok' }]
                    });
                }
            });

            // Рендер карточек фильмов
            function renderMovies() {
                movieGrid.innerHTML = '';
                movies.forEach(movie => {
                    const card = document.createElement('div');
                    card.className = 'movie-card' + (movie.id === selectedMovieId ? ' selected' : '');
                    card.dataset.id = movie.id;
                    card.innerHTML = `
                        <div class="movie-poster">${movie.emoji}</div>
                        <div class="movie-info">
                            <div class="movie-title">${movie.title}</div>
                            <div class="movie-genre">${movie.genre}</div>
                            <div class="movie-desc">${movie.desc}</div>
                        </div>
                        <button class="select-btn">Выбрать</button>
                        <div class="check-icon">✓</div>
                    `;

                    // Клик по карточке (но не по кнопке «Выбрать»)
                    card.addEventListener('click', (e) => {
                        if (e.target.classList.contains('select-btn')) return;
                        selectMovie(movie.id);
                    });

                    // Клик по кнопке «Выбрать»
                    const btn = card.querySelector('.select-btn');
                    btn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        selectMovie(movie.id);
                    });

                    movieGrid.appendChild(card);
                });
            }

            function selectMovie(id) {
                if (selectedMovieId === id) {
                    selectedMovieId = null;
                    mainButton.hide();
                } else {
                    selectedMovieId = id;
                    mainButton.show();
                }
                renderMovies();
            }

            renderMovies();
        })();
    </script>
</body>
</html>