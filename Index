<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Задачи команды</title>
  
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  
  <style>
    :root {
      --bg: var(--tg-theme-bg-color, #ffffff);
      --text: var(--tg-theme-text-color, #000000);
      --card: var(--tg-theme-secondary-bg-color, #f4f4f5);
      --hint: var(--tg-theme-hint-color, #999999);
      --button: var(--tg-theme-button-color, #3b82f6);
      --button-text: var(--tg-theme-button-text-color, #ffffff);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      padding: 16px 16px 100px;
      min-height: 100vh;
      -webkit-tap-highlight-color: transparent;
    }

    .container {
      max-width: 600px;
      margin: 0 auto;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
    }

    h1 {
      font-size: 24px;
      font-weight: 700;
    }

    .stats {
      font-size: 13px;
      color: var(--hint);
      margin-bottom: 20px;
    }

    .filters {
      display: flex;
      gap: 8px;
      margin-bottom: 16px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .filters::-webkit-scrollbar { display: none; }

    .filter {
      padding: 8px 14px;
      border-radius: 20px;
      background: var(--card);
      color: var(--text);
      border: none;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      white-space: nowrap;
    }

    .filter.active {
      background: var(--button);
      color: var(--button-text);
    }

    .tasks {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .empty {
      text-align: center;
      padding: 40px 20px;
      color: var(--hint);
      font-size: 15px;
    }

    .task {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px;
      background: var(--card);
      border-radius: 16px;
      border-left: 4px solid var(--button);
      transition: all 0.2s;
      animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .task.done {
      opacity: 0.55;
      border-left-color: #22c55e;
    }

    .task.hot:not(.done) {
      border-left-color: #f97316;
    }

    .check {
      width: 26px;
      height: 26px;
      min-width: 26px;
      border-radius: 50%;
      border: 2px solid var(--hint);
      background: transparent;
      color: white;
      cursor: pointer;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }

    .check.done {
      background: #22c55e;
      border-color: #22c55e;
    }

    .task-body {
      flex: 1;
      min-width: 0;
    }

    .task-title {
      font-size: 15px;
      font-weight: 500;
      word-wrap: break-word;
    }

    .task-title.strike {
      text-decoration: line-through;
    }

    .task-meta {
      font-size: 11px;
      color: var(--hint);
      margin-top: 4px;
    }

    .fire {
      display: inline-block;
      margin-right: 4px;
    }

    .vote {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-width: 52px;
      padding: 6px 10px;
      border-radius: 12px;
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--hint);
      cursor: pointer;
      font-size: 12px;
      transition: all 0.15s;
    }

    .vote:active {
      transform: scale(0.94);
    }

    .vote.voted {
      background: var(--button);
      color: var(--button-text);
      border-color: var(--button);
    }

    .vote-count {
      font-weight: 700;
      font-size: 14px;
      margin-top: 2px;
    }

    .add-btn {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      padding: 14px 28px;
      background: var(--button);
      color: var(--button-text);
      border: none;
      border-radius: 30px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
      z-index: 50;
    }

    .add-btn:active {
      transform: translateX(-50%) scale(0.96);
    }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      align-items: flex-end;
      justify-content: center;
      z-index: 100;
    }

    .modal.active {
      display: flex;
      animation: fadeIn 0.2s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .modal-content {
      background: var(--bg);
      border-radius: 20px 20px 0 0;
      padding: 24px 20px;
      max-width: 500px;
      width: 100%;
      animation: slideUp 0.3s ease;
    }

    @keyframes slideUp {
      from { transform: translateY(100%); }
      to { transform: translateY(0); }
    }

    .modal h2 {
      margin-bottom: 16px;
      font-size: 20px;
    }

    .modal input, .modal textarea {
      width: 100%;
      padding: 12px 14px;
      border-radius: 12px;
      border: 1px solid var(--hint);
      background: var(--card);
      color: var(--text);
      font-size: 15px;
      font-family: inherit;
      margin-bottom: 12px;
      resize: none;
    }

    .modal input:focus, .modal textarea:focus {
      outline: none;
      border-color: var(--button);
    }

    .modal-buttons {
      display: flex;
      gap: 10px;
    }

    .modal-buttons button {
      flex: 1;
      padding: 12px;
      border-radius: 12px;
      border: none;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
    }

    .btn-cancel {
      background: var(--card);
      color: var(--text);
    }

    .btn-save {
      background: var(--button);
      color: var(--button-text);
    }

    .btn-save:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
  </style>
</head>
<body>

  <div class="container">
    <header>
      <h1>🎯 Задачи команды</h1>
    </header>
    <div id="stats" class="stats"></div>
    
    <div class="filters">
      <button class="filter active" data-filter="all" onclick="setFilter('all')">Все</button>
      <button class="filter" data-filter="active" onclick="setFilter('active')">🔥 Активные</button>
      <button class="filter" data-filter="done" onclick="setFilter('done')">✅ Готово</button>
      <button class="filter" data-filter="top" onclick="setFilter('top')">⭐ Топ</button>
    </div>
    
    <div id="tasks" class="tasks"></div>
  </div>
  
  <button class="add-btn" onclick="openModal()">➕ Предложить задачу</button>
  
  <div id="modal" class="modal">
    <div class="modal-content">
      <h2>💡 Новая задача</h2>
      <input id="task-input" type="text" placeholder="Название задачи..." maxlength="100">
      <textarea id="task-desc" rows="2" placeholder="Описание (необязательно)..." maxlength="300"></textarea>
      <div class="modal-buttons">
        <button class="btn-cancel" onclick="closeModal()">Отмена</button>
        <button class="btn-save" onclick="addTask()">Добавить</button>
      </div>
    </div>
  </div>

  <script>
    const tg = window.Telegram?.WebApp;
    const user = tg?.initDataUnsafe?.user;
    const userId = user?.id || 'anonymous';
    const userName = user?.first_name || 'Аноним';

    if (tg) {
      tg.ready();
      tg.expand();
    }

    // Утилита haptic
    function haptic(type = 'light') {
      try {
        if (type === 'success') tg?.HapticFeedback?.notificationOccurred('success');
        else tg?.HapticFeedback?.impactOccurred(type);
      } catch(e) {}
    }

    // Данные (в localStorage)
    let tasks = JSON.parse(localStorage.getItem('tasks_v1')) || [
      { id: 1, title: 'Обновить документацию проекта', desc: 'Актуализировать разделы про API', votes: 5, voters: [], done: false, author: 'Иван' },
      { id: 2, title: 'Пофиксить баг с логином', desc: '', votes: 3, voters: [], done: false, author: 'Мария' },
      { id: 3, title: 'Провести ретроспективу', desc: 'Итоги спринта', votes: 8, voters: [], done: true, author: 'Пётр' }
    ];
    let currentFilter = 'all';

    function save() {
      localStorage.setItem('tasks_v1', JSON.stringify(tasks));
    }

    function setFilter(f) {
      currentFilter = f;
      document.querySelectorAll('.filter').forEach(b => {
        b.classList.toggle('active', b.dataset.filter === f);
      });
      haptic('light');
      render();
    }

    function getFiltered() {
      let list = [...tasks];
      if (currentFilter === 'active') list = list.filter(t => !t.done);
      else if (currentFilter === 'done') list = list.filter(t => t.done);
      else if (currentFilter === 'top') list = list.filter(t => !t.done && t.votes >= 5);
      list.sort((a, b) => {
        if (a.done !== b.done) return a.done ? 1 : -1;
        return b.votes - a.votes;
      });
      return list;
    }

    function render() {
      const container = document.getElementById('tasks');
      const list = getFiltered();
      const stats = document.getElementById('stats');
      const active = tasks.filter(t => !t.done).length;
      const done = tasks.filter(t => t.done).length;
      stats.textContent = `Активных: ${active} · Выполнено: ${done}`;
      
      container.innerHTML = '';
      
      if (list.length === 0) {
        container.innerHTML = '<div class="empty">Пока пусто 🌱<br>Предложите первую задачу!</div>';
        return;
      }
      
      list.forEach(task => {
        const isVoted = task.voters.includes(userId);
        const isHot = task.votes >= 5 && !task.done;
        const div = document.createElement('div');
        div.className = 'task' + (task.done ? ' done' : '') + (isHot ? ' hot' : '');
        div.innerHTML = `
          <button class="check ${task.done ? 'done' : ''}" onclick="toggleDone(${task.id})">
            ${task.done ? '✓' : ''}
          </button>
          <div class="task-body">
            <div class="task-title ${task.done ? 'strike' : ''}">
              ${isHot ? '<span class="fire">🔥</span>' : ''}${escapeHtml(task.title)}
            </div>
            ${task.desc ? `<div class="task-meta">${escapeHtml(task.desc)}</div>` : ''}
            <div class="task-meta">от ${escapeHtml(task.author)}</div>
          </div>
          <button class="vote ${isVoted ? 'voted' : ''}" onclick="vote(${task.id})">
            👍
            <span class="vote-count">${task.votes}</span>
          </button>
        `;
        container.appendChild(div);
      });
    }

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    function vote(id) {
      const task = tasks.find(t => t.id === id);
      if (!task) return;
      const idx = task.voters.indexOf(userId);
      if (idx >= 0) {
        task.voters.splice(idx, 1);
        task.votes--;
      } else {
        task.voters.push(userId);
        task.votes++;
      }
      haptic('light');
      save();
      render();
    }

    function toggleDone(id) {
      const task = tasks.find(t => t.id === id);
      if (!task) return;
      task.done = !task.done;
      haptic('success');
      save();
      render();
    }

    function openModal() {
      document.getElementById('modal').classList.add('active');
      setTimeout(() => document.getElementById('task-input').focus(), 100);
    }

    function closeModal() {
      document.getElementById('modal').classList.remove('active');
      document.getElementById('task-input').value = '';
      document.getElementById('task-desc').value = '';
    }

    function addTask() {
      const input = document.getElementById('task-input');
      const desc = document.getElementById('task-desc');
      const title = input.value.trim();
      if (!title) return;
      
      const newTask = {
        id: Date.now(),
        title: title,
        desc: desc.value.trim(),
        votes: 1,
        voters: [userId],
        done: false,
        author: userName
      };
      tasks.unshift(newTask);
      save();
      render();
      closeModal();
      haptic('success');
    }

    // Закрыть модалку по клику на затемнение
    document.getElementById('modal').addEventListener('click', (e) => {
      if (e.target.id === 'modal') closeModal();
    });

    // Enter в поле → добавить
    document.getElementById('task-input').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') addTask();
    });

    render();
  </script>

</body>
</html>
